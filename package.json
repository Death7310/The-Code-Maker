{
  "name": "the-code-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Learn security by building it: offline Python projects, a simulated Linux terminal, investigations and certification prep. Website, Android and macOS.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-web.js",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "desktop": "npm run build && electron .",
    "desktop:mac": "npm run build && electron-builder --mac --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "electron": "36.9.5",
    "electron-builder": "26.0.12",
    "pyodide": "0.27.7"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "io.github.death7310.codemaker",
    "productName": "The Code Maker",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build-resources"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "TheCodeMaker-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "The Code Maker"
    }
  }
}
